---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import RootLayout from "@/layouts/RootLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const allPosts = await getCollection("blog");
const relatedPosts = allPosts
  .filter((p) => !p.data.draft && p.data.project?.id === project.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

async function fetchStars(repo: string): Promise<number> {
  try {
    const res = await fetch(`https://api.github.com/repos/${repo}`, {
      headers: { Accept: "application/vnd.github.v3+json" },
    });
    if (!res.ok) return 0;
    const json = await res.json();
    return json.stargazers_count ?? 0;
  } catch {
    return 0;
  }
}

const stars = await fetchStars(data.github);

const statusColors: Record<string, string> = {
  actif: "bg-green-50 text-green-700 dark:bg-green-950/50 dark:text-green-400",
  wip: "bg-amber-50 text-amber-700 dark:bg-amber-950/50 dark:text-amber-400",
  archive: "bg-gray-100 text-gray-500 dark:bg-gray-800 dark:text-gray-400",
};
const statusClass = statusColors[data.status] ?? statusColors.actif;
---

<RootLayout
  title={`${data.title} — Projets`}
  description={data.description}
>
  <div class="pb-8 pt-6">
    <Breadcrumbs
      items={[
        { label: "Accueil", href: "/" },
        { label: "Projets", href: "/projects" },
        { label: data.title },
      ]}
    />
  </div>

  <!-- Cover image -->
  {data.cover ? (
    <div class="mb-10 overflow-hidden rounded-2xl">
      <Image
        src={data.cover}
        alt={data.title}
        width={1200}
        height={480}
        class="h-56 w-full object-cover sm:h-72"
      />
    </div>
  ) : (
    <div class="mb-10 flex h-48 items-center justify-center rounded-2xl bg-gradient-to-br from-primary-50 to-primary-100 dark:from-primary-950/40 dark:to-primary-900/20 sm:h-64">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-primary-200 dark:text-primary-800" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
      </svg>
    </div>
  )}

  <!-- Two-column layout -->
  <div class="lg:grid lg:grid-cols-3 lg:gap-12">

    <!-- Main content -->
    <div class="lg:col-span-2">

      <!-- Title + description -->
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl">
        {data.title}
      </h1>
      <p class="mt-3 text-lg text-gray-600 dark:text-gray-400">
        {data.description}
      </p>

      <!-- Tags -->
      <div class="mt-4 flex flex-wrap gap-2">
        {data.tags.map((tag) => (
          <span class="rounded-md bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-400">
            {tag}
          </span>
        ))}
      </div>

      <!-- MDX content -->
      <div class="prose prose-gray mt-10 max-w-none dark:prose-invert prose-headings:font-bold prose-h2:mt-10 prose-h2:text-xl prose-a:text-primary-600 dark:prose-a:text-primary-400 prose-code:rounded prose-code:bg-gray-100 prose-code:px-1 prose-code:py-0.5 prose-code:text-sm dark:prose-code:bg-gray-800">
        <Content />
      </div>

    </div>

    <!-- Sidebar -->
    <aside class="mt-12 lg:col-span-1 lg:mt-0">
      <div class="lg:sticky lg:top-8 space-y-6">

        <!-- Meta card -->
        <div class="rounded-2xl border border-primary-200 bg-primary-50 p-5 dark:border-primary-900/40 dark:bg-primary-950/20">
          <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-primary-700 dark:text-primary-400">Infos</p>

          <!-- Status + open source + year -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ${statusClass}`}>
                {data.status}
              </span>
              <span class="inline-flex items-center gap-1 rounded-full bg-primary-100 px-2.5 py-0.5 text-xs font-medium text-primary-600 dark:bg-primary-900/40 dark:text-primary-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                </svg>
                open source
              </span>
            </div>
            {data.year && (
              <span class="text-xs text-primary-500 dark:text-primary-400">{data.year}</span>
            )}
          </div>

          <!-- Stars -->
          <div class="mt-3 flex items-center gap-1.5 text-sm text-primary-600 dark:text-primary-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            <span>{stars} étoile{stars !== 1 ? "s" : ""} GitHub</span>
          </div>

          <hr class="my-4 border-primary-200 dark:border-primary-900/40" />

          <!-- Links -->
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-primary-700 dark:text-primary-400">Liens</p>
          <div class="flex flex-col gap-2">
            <a
              href={`https://github.com/${data.github}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-lg border border-primary-300 bg-white px-4 py-2 text-sm font-medium text-primary-700 transition-colors hover:border-primary-400 hover:bg-primary-100 dark:border-primary-800 dark:bg-primary-900/30 dark:text-primary-300 dark:hover:bg-primary-900/50"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
              </svg>
              Voir sur GitHub
            </a>
            {data.demo && (
              <a
                href={data.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary-500 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-primary-600"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"/>
                </svg>
                Voir la démo
              </a>
            )}
          </div>
        </div>

        <!-- Articles liés -->
        {relatedPosts.length > 0 && (
          <div class="rounded-2xl border border-sky-200 bg-sky-50 p-5 dark:border-sky-900/40 dark:bg-sky-950/20">
            <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-sky-700 dark:text-sky-400">
              Articles liés
            </h2>
            <ul class="space-y-3">
              {relatedPosts.map((post) => (
                <li>
                  <a
                    href={`/blog/${post.id}`}
                    class="text-sm font-medium text-sky-900 transition-colors hover:text-sky-600 dark:text-sky-200 dark:hover:text-sky-400"
                  >
                    {post.data.title}
                  </a>
                  <time
                    datetime={post.data.date.toISOString()}
                    class="mt-0.5 block text-xs text-sky-500 dark:text-sky-600"
                  >
                    {post.data.date.toLocaleDateString("fr-FR", { year: "numeric", month: "short", day: "numeric" })}
                  </time>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Stack technique -->
        {data.stack.length > 0 && (
          <div class="rounded-2xl border border-amber-200 bg-amber-50 p-5 dark:border-amber-900/40 dark:bg-amber-950/20">
            <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-amber-800 dark:text-amber-400">
              Stack technique
            </h2>
            <ul class="space-y-2">
              {data.stack.map((item) => (
                <li class="flex items-center gap-2 text-sm text-amber-900 dark:text-amber-300">
                  <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-amber-400 dark:bg-amber-500"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        )}

      </div>
    </aside>

  </div>
</RootLayout>
