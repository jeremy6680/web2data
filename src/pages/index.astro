---
/**
 * index.astro — Hub homepage for web2data.org
 *
 * Replaces the old blog post list with an immersive open-source hub.
 * Blog posts remain accessible at /blog.
 */
import RootLayout from "@/layouts/RootLayout.astro";
import HeroSection from "@/components/home/HeroSection.astro";
import AboutTeaser from "@/components/home/AboutTeaser.astro";
import ProjectsSection from "@/components/home/ProjectsSection.astro";
import LatestPostsSection from "@/components/home/LatestPostsSection.astro";
import { SITE_METADATA } from "@/consts";
---

<RootLayout
  title={SITE_METADATA.title}
  description={SITE_METADATA.description}
>
  <HeroSection />
  <ProjectsSection />
  <LatestPostsSection />
  <AboutTeaser />
</RootLayout>