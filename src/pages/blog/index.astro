---
/**
 * blog/index.astro
 * Main blog listing — rendered at /blog.
 * Passes ALL posts to ListWithTagsLayout to enable full client-side filtering
 * (domain, category, techno, year, search).
 * Paginated routes (/blog/page/N) remain available for bots/RSS via blog/page/[...page].astro.
 */
import { getCollection } from "astro:content";
import { sortBlogPosts, excludeDrafts } from "@/functions";
import ListWithTagsLayout from "@/layouts/ListWithTagsLayout.astro";
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import { ITEMS_PER_PAGE } from "@/consts";
import { useTranslations } from "@/i18n";

const t = useTranslations();

// Fetch all published posts (needed for client-side filtering)
const allPosts = await getCollection("blog", excludeDrafts).then(sortBlogPosts);

// Build a minimal Page object (required by the layout's Props interface).
// In filter mode, allPosts overrides page.data, so this is only a structural stub.
const pageSize = ITEMS_PER_PAGE;
const total = allPosts.length;
const lastPage = Math.ceil(total / pageSize);

const page: Page<CollectionEntry<"blog">> = {
  data: allPosts.slice(0, pageSize), // not used in filter mode
  start: 0,
  end: Math.min(pageSize, total) - 1,
  total,
  currentPage: 1,
  size: pageSize,
  lastPage,
  url: {
    current: "/blog",
    next: lastPage > 1 ? "/blog/page/2" : undefined,
    prev: undefined,
    first: "/blog",
    last: lastPage > 1 ? `/blog/page/${lastPage}` : "/blog",
  },
};
---

<ListWithTagsLayout
  title={t("pages.blog.title")}
  description={t("pages.blog.description")}
  page={page}
  allPosts={allPosts}
/>
