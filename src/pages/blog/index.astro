---
/**
 * blog/index.astro
 * Page principale du blog — mode "load more".
 * Tous les articles sont rendus côté serveur dans le DOM.
 * Le JS masque tout ce qui dépasse 12, et le bouton "Charger plus"
 * en révèle 12 de plus à chaque clic.
 * Les filtres (domaine, catégorie, techno, année) fonctionnent sur l'ensemble.
 */
import { getCollection } from "astro:content";
import { sortBlogPosts, excludeDrafts } from "@/functions";
import ListWithTagsLayout from "@/layouts/ListWithTagsLayout.astro";
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import { ITEMS_PER_PAGE } from "@/consts";
import { useTranslations } from "@/i18n";

const t = useTranslations();

// Tous les articles publiés — passés à allPosts pour activer le mode load-more
const allPosts = await getCollection("blog", excludeDrafts).then(sortBlogPosts);

// Stub Page requis par l'interface du layout (non utilisé en mode load-more)
const total    = allPosts.length;
const lastPage = Math.ceil(total / ITEMS_PER_PAGE);

const page: Page<CollectionEntry<"blog">> = {
  data: allPosts,
  start: 0,
  end: total - 1,
  total,
  currentPage: 1,
  size: total,
  lastPage,
  url: {
    current: "/blog",
    next: undefined,
    prev: undefined,
    first: "/blog",
    last: "/blog",
  },
};
---

<ListWithTagsLayout
  title={t("pages.blog.title")}
  description={t("pages.blog.description")}
  page={page}
  allPosts={allPosts}
  breadcrumbs={[
    { label: t("nav.home"), href: "/" },
    { label: t("nav.blog") },
  ]}
/>
