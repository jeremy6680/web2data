---
import RootLayout from "@/layouts/RootLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
---

<RootLayout
  title="Contact — Jérémy Marchandeau"
  description="Envie d'échanger sur la data, l'IA, le développement web ou l'open source ? Je suis là."
>
  <div class="space-y-2 pb-8 pt-6">
    <Breadcrumbs items={[{ label: "Accueil", href: "/" }, { label: "Contact" }]} />
    <h1 class="text-3xl font-extrabold leading-9 tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl">
      Contact
    </h1>
    <p class="text-lg leading-7 text-gray-500 dark:text-gray-400">
      Une question, une idée, une collaboration ? Je suis ouvert.
    </p>
  </div>

  <div class="border-t border-gray-100 py-12 dark:border-gray-800">
    <div class="mx-auto max-w-xl">

      <!-- Email -->
      <div class="mb-10">
        <h2 class="mb-1 text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-600">
          Email
        </h2>
        <a
          href="mailto:hey@jeremymarchandeau.com"
          class="inline-flex items-center gap-2 text-lg font-medium text-gray-900 transition-colors hover:text-primary-500 dark:text-gray-100 dark:hover:text-primary-400"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
          </svg>
          hey@jeremymarchandeau.com
        </a>
      </div>

      <!-- Social links -->
      <div>
        <h2 class="mb-4 text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-600">
          Réseaux
        </h2>
        <ul class="space-y-4">
          <li>
            <a
              href="https://github.com/jeremy6680"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-3 text-gray-700 transition-colors hover:text-primary-500 dark:text-gray-300 dark:hover:text-primary-400"
            >
              <span class="flex h-10 w-10 items-center justify-center rounded-lg border border-gray-200 bg-white transition-colors group-hover:border-primary-300 dark:border-gray-700 dark:bg-gray-900">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                </svg>
              </span>
              <div>
                <div class="font-medium">GitHub</div>
                <div class="text-sm text-gray-400">@jeremy6680</div>
              </div>
            </a>
          </li>
          <li>
            <a
              href="https://linkedin.com/in/jeremymarchandeau"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-3 text-gray-700 transition-colors hover:text-primary-500 dark:text-gray-300 dark:hover:text-primary-400"
            >
              <span class="flex h-10 w-10 items-center justify-center rounded-lg border border-gray-200 bg-white transition-colors group-hover:border-primary-300 dark:border-gray-700 dark:bg-gray-900">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </span>
              <div>
                <div class="font-medium">LinkedIn</div>
                <div class="text-sm text-gray-400">Jeremy Marchandeau</div>
              </div>
            </a>
          </li>
          <li>
            <a
              href="https://x.com/tweetsbyjey"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-3 text-gray-700 transition-colors hover:text-primary-500 dark:text-gray-300 dark:hover:text-primary-400"
            >
              <span class="flex h-10 w-10 items-center justify-center rounded-lg border border-gray-200 bg-white transition-colors group-hover:border-primary-300 dark:border-gray-700 dark:bg-gray-900">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </span>
              <div>
                <div class="font-medium">X / Twitter</div>
                <div class="text-sm text-gray-400">@tweetsbyjey</div>
              </div>
            </a>
          </li>
        </ul>
      </div>

      <!-- Note -->
      <p class="mt-12 text-sm text-gray-400 dark:text-gray-600">
        Je réponds à tous les messages, généralement sous 48h.
        Pour les collaborations ou missions freelance, précise le contexte dans ton message.
      </p>

    </div>
  </div>
</RootLayout>
