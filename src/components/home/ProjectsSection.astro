---
/**
 * ProjectsSection.astro
 * Showcases open-source projects as rich image cards with GitHub stars.
 */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const allProjects = await getCollection("projects");
const projects = allProjects.sort((a, b) => a.data.order - b.data.order).slice(0, 6);

async function fetchStars(repo: string): Promise<number> {
  try {
    const res = await fetch(`https://api.github.com/repos/${repo}`, {
      headers: { Accept: "application/vnd.github.v3+json" },
    });
    if (!res.ok) return 0;
    const data = await res.json();
    return data.stargazers_count ?? 0;
  } catch {
    return 0;
  }
}

const projectsWithStars = await Promise.all(
  projects.map(async (p) => ({
    ...p,
    stars: await fetchStars(p.data.github),
  }))
);
---

<section class="py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-gray-100">
        Projets open source
      </h2>
      <p class="mt-4 text-base text-gray-600 dark:text-gray-400">
        Tous les projets sont publics sur GitHub. Forkez, contribuez, réutilisez.
      </p>
    </div>

    <!-- Projects grid -->
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {projectsWithStars.map((project) => (
        <li class="group flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md dark:border-gray-800 dark:bg-gray-900">

          <!-- Cover → fiche projet -->
          {project.data.cover ? (
            <a href={`/projects/${project.id}`} class="block overflow-hidden" aria-label={`Voir la fiche ${project.data.title}`}>
              <Image src={project.data.cover} alt={project.data.title} width={544} height={220}
                class="h-40 w-full object-cover transition-transform duration-300 group-hover:scale-105" />
            </a>
          ) : (
            <a href={`/projects/${project.id}`} class="flex h-40 items-center justify-center bg-gradient-to-br from-primary-50 to-primary-100 dark:from-primary-950/40 dark:to-primary-900/20" aria-label={`Voir la fiche ${project.data.title}`}>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-primary-300 dark:text-primary-700" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
              </svg>
            </a>
          )}

          <!-- Card body -->
          <div class="flex flex-1 flex-col p-5">

            <!-- Status + Stars -->
            <div class="mb-3 flex items-center justify-between">
              <span class="inline-flex items-center rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-700 dark:bg-green-950/50 dark:text-green-400">
                {project.data.status}
              </span>
              <span class="inline-flex items-center gap-1 text-xs text-gray-400 dark:text-gray-500">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                {project.stars}
              </span>
            </div>

            <!-- Title → fiche projet -->
            <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">
              <a href={`/projects/${project.id}`} class="transition-colors hover:text-primary-500 dark:hover:text-primary-400">
                {project.data.title}
              </a>
            </h3>

            <!-- Description -->
            <p class="mt-2 flex-1 text-sm leading-6 text-gray-600 dark:text-gray-400">
              {project.data.description}
            </p>

            <!-- Tags -->
            <div class="mt-4 flex flex-wrap gap-1.5">
              {project.data.tags.map((tag) => (
                <span class="rounded-md bg-gray-100 px-2 py-0.5 text-xs text-gray-600 dark:bg-gray-800 dark:text-gray-400">
                  {tag}
                </span>
              ))}
            </div>

            <!-- Links -->
            <div class="mt-5 flex items-center gap-4 text-sm font-medium">
              <a href={`https://github.com/${project.data.github}`} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-gray-500 transition-colors hover:text-gray-700 dark:text-gray-500 dark:hover:text-gray-300"
                aria-label={`Voir ${project.data.title} sur GitHub`}>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                </svg>
                GitHub
              </a>
              <a href={`/projects/${project.id}`} class="text-primary-500 transition-colors hover:text-primary-600 dark:hover:text-primary-400">
                Voir la fiche →
              </a>
            </div>
          </div>
        </li>
      ))}
    </ul>

    <!-- Link to full projects page -->
    <div class="mt-12 text-center">
      <a
        href="/projects"
        class="text-sm font-medium text-primary-500 transition-colors hover:text-primary-600 dark:hover:text-primary-400"
      >
        Voir tous les projets →
      </a>
    </div>

  </div>
</section>
