---
/**
 * ProjectsSection.astro
 * Showcases open-source projects as a card grid.
 * Projects are hardcoded here; migrate to Content Collection in phase 2.
 */

// Project data — update this array as new projects are added
const projects = [
  {
    title: "web2data",
    description: "Ce blog lui-même — construit avec Astro v5 et Tailwind CSS v4. Code source ouvert, contributions bienvenues.",
    url: "https://github.com/jeremy6680/web2data",
    demo: "https://web2data.jeremymarchandeau.com",
    tags: ["Astro", "Tailwind", "MDX"],
    status: "actif",
  },
  // Add more projects here
];
---

<section class="py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-gray-100">
        Projets open source
      </h2>
      <p class="mt-4 text-base text-gray-600 dark:text-gray-400">
        Tous les projets sont publics sur GitHub. Forkez, contribuez, réutilisez — c'est fait pour ça.
      </p>
    </div>

    <!-- Projects grid -->
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {projects.map((project) => (
        <li class="group relative flex flex-col rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md dark:border-gray-800 dark:bg-gray-900">

          <!-- Status + open-source badge -->
          <div class="mb-4 flex items-center justify-between">
            <span class="inline-flex items-center rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-700 dark:bg-green-950/50 dark:text-green-400">
              {project.status}
            </span>
            <span class="inline-flex items-center gap-1 text-xs text-gray-400 dark:text-gray-600">
              <!-- Lock-open icon -->
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M10 2a5 5 0 00-5 5v1H4a2 2 0 00-2 2v7a2 2 0 002 2h12a2 2 0 002-2V10a2 2 0 00-2-2h-1V7a5 5 0 00-5-5zm0 2a3 3 0 013 3v1H7V7a3 3 0 013-3zm0 8a1 1 0 110 2 1 1 0 010-2z"/>
              </svg>
              Open source
            </span>
          </div>

          <!-- Title -->
          <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">
            {project.title}
          </h3>

          <!-- Description -->
          <p class="mt-2 flex-1 text-sm leading-6 text-gray-600 dark:text-gray-400">
            {project.description}
          </p>

          <!-- Tags -->
          <div class="mt-4 flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="rounded-md bg-gray-100 px-2 py-0.5 text-xs text-gray-600 dark:bg-gray-800 dark:text-gray-400">
                {tag}
              </span>
            ))}
          </div>

          <!-- Links -->
          <div class="mt-6 flex items-center gap-4 text-sm font-medium">
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-gray-700 transition-colors hover:text-primary-500 dark:text-gray-300 dark:hover:text-primary-400"
              aria-label={`Voir le code source de ${project.title} sur GitHub`}
            >
              <!-- GitHub icon -->
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
              </svg>
              GitHub
            </a>
            {project.demo && (
              <a
                href={project.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-primary-500 transition-colors hover:text-primary-600 dark:hover:text-primary-400"
                aria-label={`Voir la démo de ${project.title}`}
              >
                Démo →
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>

    <!-- Link to full projects page -->
    <div class="mt-12 text-center">
      <a
        href="/projects"
        class="text-sm font-medium text-primary-500 transition-colors hover:text-primary-600 dark:hover:text-primary-400"
      >
        Voir tous les projets →
      </a>
    </div>

  </div>
</section>