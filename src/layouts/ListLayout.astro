---
import type { CollectionEntry } from "astro:content";
import type { Page } from "astro";

import ListPostCover from "@/components/ListPostCover.astro";
import Link from "../components/Link.astro";
import Pagination from "../components/Pagination.astro";
import RootLayout from "./RootLayout.astro";
import Techno from "../components/Techno.astro";

interface Props {
  title: string;
  description: string;
  titleTemplate?: string;
  page: Page<CollectionEntry<"blog">>;
  robots?: string;
}

const { title, description, page, robots, titleTemplate } = Astro.props;
const hasDefaultSlot = Astro.slots.has("default");
---

<RootLayout {title} {description} {robots} {titleTemplate}>
  <div class="divide-y divide-gray-200 dark:divide-gray-700">
    <div class="space-y-2 pb-8 pt-6 md:space-y-5">
      <!-- H1 unifié via page-title -->
      <h1 class="page-title">
        {title}
      </h1>
      {
        hasDefaultSlot && (
          <div class="prose dark:prose-invert py-4">
            <slot />
          </div>
        )
      }
    </div>
    <ul>
      {!page.data.length && "No posts found."}
      {
        page.data.map((post) => {
          const {
            id,
            data: { title, summary, technos },
          } = post;
          return (
            <li class="py-4">
              <article class="space-y-2 xl:grid xl:grid-cols-4 space-x-4 xl:space-y-0 xl:items-stretch">
                <ListPostCover {post} class="space-y-5 xl:col-span-1" />
                <div class="space-y-3 xl:col-span-3">
                  <div>
                    <!-- article-title : cohérent avec ListWithTagsLayout et HP -->
                    <h3 class="article-title">
                      <Link
                        href={`/blog/${id}`}
                        class="hover:text-primary-500 dark:hover:text-primary-400 transition-colors"
                      >
                        {title}
                      </Link>
                    </h3>
                    <div class="flex flex-wrap">
                      {technos.map(({ id }) => (
                        <Techno slug={id} />
                      ))}
                    </div>
                  </div>
                  <div class="summary-text">
                    {summary}
                  </div>
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>
  </div>
  {(page.url.next || page.url.prev) && <Pagination page={page} />}
</RootLayout>
